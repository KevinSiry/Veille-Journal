# =============================================================================
# Veille Journal - modèle de configuration
# =============================================================================
# Copiez ce fichier À CÔTÉ des fichiers compose :
#   - en local : docker/.env        (cp .env.example docker/.env)
#   - sur le VPS : $DEPLOY_PATH/.env (par ex. /opt/veille-journal/.env)
# Ne commitez JAMAIS le fichier .env (il est ignoré par git).
#
# IMPORTANT - le caractère « $ » :
#   docker compose interprète « $ » dans ce fichier (y compris via env_file).
#   Toute valeur contenant « $ » (le hash argon2 notamment) doit être entourée
#   d'apostrophes simples : CLE='valeur$avec$dollars'. Sans apostrophes, ou avec
#   des guillemets doubles, les morceaux « $xxx » sont remplacés par du vide.
#   (Alternative : doubler chaque $ en $$, sans apostrophes.)
# =============================================================================

# --- Sécurité ----------------------------------------------------------------

# Hash argon2id du mot de passe de connexion (jamais le mot de passe en clair).
# Générer :  docker compose -f docker/compose.yml -f docker/compose.dev.yml run --rm --no-deps web veille hash-password
#      ou :  uv run veille hash-password
# Collez le résultat ENTRE APOSTROPHES SIMPLES, par exemple :
# APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$xxxxxxxx$yyyyyyyy'
APP_PASSWORD_HASH='a-remplacer-par-le-hash-argon2'

# Secret de signature des cookies de session (48 caractères aléatoires ou plus).
# Générer :  python -c "import secrets; print(secrets.token_urlsafe(48))"
#      ou :  openssl rand -base64 48
SESSION_SECRET=a-remplacer-par-un-secret-aleatoire

# true en production (HTTPS derrière le reverse proxy). Le fichier
# docker/compose.dev.yml force false en local (http://localhost).
COOKIE_SECURE=true

# --- Stockage ----------------------------------------------------------------

# Base SQLite, dans le volume docker « veille-data » monté sur /data.
DATABASE_PATH=/data/veille.db

# --- Services internes (noms des conteneurs sur le réseau docker) -------------

OLLAMA_URL=http://ollama:11434
# Modèle de résumé (~5 Go) et modèle d'embeddings (~1,2 Go), téléchargés au
# premier démarrage par le service ollama-init.
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3

SEARXNG_URL=http://searxng:8080
# Secret interne de SearXNG (aléatoire, jamais réutilisé ailleurs).
# Générer :  python -c "import secrets; print(secrets.token_hex(32))"
#      ou :  openssl rand -hex 32
SEARXNG_SECRET=a-remplacer-par-un-secret-aleatoire

# --- Planification -------------------------------------------------------------

# Heure de génération quotidienne (HH:MM), dans le fuseau TIMEZONE.
RUN_AT=05:30
TIMEZONE=Europe/Paris

# --- Réglages du pipeline ----------------------------------------------------

# Nombre maximum d'actualités retenues par thème et par jour.
MAX_ITEMS_PER_THEME=8
# Similarité minimale (embeddings) entre une actualité et le thème (-1 à 1).
RELEVANCE_THRESHOLD=0.45
# Similarité à partir de laquelle deux actualités sont considérées identiques (0 à 1).
DEDUPE_THRESHOLD=0.88
# Fenêtre de collecte : ancienneté maximale des actualités, en heures.
LOOKBACK_HOURS=36
# Délai maximum d'une réponse du modèle local, en secondes (CPU : soyez large).
LLM_TIMEOUT_S=180

# --- Divers --------------------------------------------------------------------

# DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO

# --- Utilisés par docker compose uniquement ----------------------------------

# Version de l'image ghcr.io/kevinsiry/veille-journal à lancer (sans le « v »).
# Le déploiement automatique la passe lui-même ; latest par défaut.
IMAGE_TAG=latest
# Port local (127.0.0.1 uniquement) sur lequel le reverse proxy joint le site.
WEB_PORT=8080

# Limites d'Ollama (production). OLLAMA_CPUS ne doit pas dépasser le nombre de
# processeurs de la machine (en local, compose.dev.yml supprime cette limite).
#OLLAMA_CPUS=6.0
#OLLAMA_MEM_LIMIT=12g

# Fichiers compose à utiliser sans les passer en -f (VPS uniquement), par ex.
# pour ajouter l'intégration Traefik (séparateur « : » sous Linux) :
#COMPOSE_FILE=compose.yml:compose.traefik.yml
